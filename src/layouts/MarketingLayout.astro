---
import '../styles/marketing.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Aesthetic Dine',
  description = 'Beautiful restaurant websites with hosting — built for Bangladesh.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="https://aesthetic-design.sirv.com/Aesthetic%20Dine/Images/aesthetic-dine-favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Outfit:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('aesthetic-theme');
        if (saved) document.documentElement.setAttribute('data-theme', saved);
      })();
    </script>
  </head>
  <body>
    <div class="cursor-glow" aria-hidden="true"></div>
    <canvas id="particles" aria-hidden="true"></canvas>
    <slot />
    <script>
      import '../scripts/marketing';
    </script>
  </body>
</html>
