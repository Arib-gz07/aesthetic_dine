---
const items = [
  {
    label: 'Hero & branding',
    image: 'https://aesthetic-dine.sirv.com/Aesthetic%20Dine/SS/demo-kitchen-hero.png',
    delay: '1',
    href: '/sites/demo',
  },
  {
    label: 'Menu showcase',
    image: 'https://aesthetic-dine.sirv.com/Aesthetic%20Dine/SS/demo-kitchen-menu.png',
    delay: '2',
    href: '/sites/demo#menu',
  },
  {
    label: 'Location & map',
    image: 'https://aesthetic-dine.sirv.com/Aesthetic%20Dine/SS/demo-kitchen-location.png',
    delay: '3',
    href: '/sites/demo#location',
  },
  {
    label: 'Phone reservations',
    image: 'https://aesthetic-dine.sirv.com/Aesthetic%20Dine/SS/demo-kitchen-contact.png',
    delay: '4',
    href: '/sites/demo#contact',
  },
  {
    label: 'Live demo site',
    image: 'https://aesthetic-dine.sirv.com/Aesthetic%20Dine/SS/demo-kitchen-live.png',
    delay: '5',
    wide: true,
    href: '/sites/demo',
  },
];
---

<section id="gallery" class="gallery">
  <div class="section-header">
    <span class="section-label" data-animate="fade-up">Examples</span>
    <h2 class="section-title" data-animate="fade-up" data-delay="1">What your site includes</h2>
  </div>
  <div class="gallery-grid">
    {
      items.map((item) => (
        <a
          href={item.href}
          class:list={['gallery-item', item.wide && 'wide']}
          data-animate="scale-in"
          data-delay={item.delay}
          style="text-decoration: none; display: block;"
        >
          <div class="gallery-inner">
            <img src={item.image} alt={item.label} class="gallery-image" loading="lazy" width="1200" height="900" />
            <span class="gallery-label">{item.label}</span>
          </div>
        </a>
      ))
    }
  </div>
</section>
